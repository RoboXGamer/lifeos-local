    "@solidjs/web": "2.0.3",
    "nanoid": "6.0.2",
    "solid-js": "2.0.3",
    "unpdf": "^1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@solidjs/diagnostics": "2.0.3",
    "@solidjs/vite-plugin": "3.0.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.8"
