{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*/*"] },
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "updater:default",
    "process:allow-restart"
  ]
}
