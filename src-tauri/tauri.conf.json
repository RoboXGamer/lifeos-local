{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-solid-draft1",
  "version": "0.1.0",
  "identifier": "dev.a5in.tauri-solid-draft1",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tauri-solid-draft1",
        "width": 900,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
